# Python / local environment
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime logs
output.log
*.log

# Local datasets and generated training pairs
traditional_houses/
data/
dataset/
datasets/
dump_artifact/

# Local model caches and downloaded pretrained weights
models/
!models/.gitkeep
*.ckpt
*.safetensors
*.pt
*.pth
*.bin
*.onnx
*.gguf

# Hugging Face / Diffusers cache metadata
.cache/
**/.cache/

# Runtime outputs are large and should stay local.
outputs/

# Keep curated result artifacts trackable.
!results/
!results/**

# Never track compressed bundles, including under results/.
*.zip
